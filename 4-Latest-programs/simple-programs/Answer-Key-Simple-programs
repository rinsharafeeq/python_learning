10. Mini to-do using JSON (add and view only)
python
import json

def add_task(task):
    try:
        with open("tasks.json", "r") as f:
            tasks = json.load(f)
    except:
        tasks = []
    tasks.append(task)
    with open("tasks.json", "w") as f:
        json.dump(tasks, f)

def show_tasks():
    with open("tasks.json", "r") as f:
        print(json.load(f))

add_task("Buy milk")
show_tasks()
