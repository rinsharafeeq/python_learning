7. Class + JSON together – save and load one object
python
import json

class User:
    def __init__(self, name, score):
        self.name = name
        self.score = score

user = User("Bob", 100)
# Save
with open("user.json", "w") as f:
    json.dump({"name": user.name, "score": user.score}, f)
# Load
with open("user.json", "r") as f:
    data = json.load(f)
    loaded_user = User(data["name"], data["score"])
    print(loaded_user.name, loaded_user.score)
