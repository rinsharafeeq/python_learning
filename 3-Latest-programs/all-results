import datetime

def add_task():
    """Append a new task with a timestamp to tasks.txt"""
    try:
        task = input("What is your task for today? ")
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        with open("tasks.txt", "a") as file:
            file.write(f"{timestamp} - {task}\n")
        
        print("Task saved!")
    except Exception as e:
        print(f"An error occurred while saving: {e}")

def show_tasks():
    """Read and display all saved tasks"""
    try:
        with open("tasks.txt", "r") as file:
            content = file.read()
            if content:
                print("\n--- All Tasks ---")
                print(content)
            else:
                print("No tasks found.")
    except FileNotFoundError:
        print("No task file exists yet. Add some tasks first.")

# Main program
if __name__ == "__main__":
    show_tasks()
    add_task()
