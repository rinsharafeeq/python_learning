import datetime

LOG_FILE = "app.log"

def parse_logs_by_date():
    """Print all ERROR lines from a user-provided date"""
    date_str = input("Enter date (YYYY-MM-DD): ").strip()
    
    # Validate date format
    try:
        target_date = datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        print("Invalid date format. Use YYYY-MM-DD")
        return
    
    try:
        with open(LOG_FILE, "r") as file:
            lines = file.readlines()
    except FileNotFoundError:
        print(f"Log file '{LOG_FILE}' not found.")
        return
    
    error_count = 0
    print(f"\nERROR lines from {date_str}:")
    for line in lines:
        line = line.strip()
        if not line:
            continue
        # Expected format: "ERROR 2025-03-20 10:15:00 Disk full"
        parts = line.split()
        if len(parts) >= 3 and parts[0].upper() == "ERROR":
            try:
                log_date = datetime.datetime.strptime(parts[1], "%Y-%m-%d").date()
                if log_date == target_date:
                    print(line)
                    error_count += 1
            except ValueError:
                # Skip lines where the second part isn't a valid date
                continue
    
    print(f"\nTotal errors on {date_str}: {error_count}")

if __name__ == "__main__":
    parse_logs_by_date()

