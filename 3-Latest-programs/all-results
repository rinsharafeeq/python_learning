import datetime

PRODUCT_FILE = "products.txt"

def add_product(name, expiry_date_str):
    """Add a product with its expiry date (YYYY-MM-DD)"""
    try:
        # Validate date format
        expiry_date = datetime.datetime.strptime(expiry_date_str, "%Y-%m-%d").date()
        
        with open(PRODUCT_FILE, "a") as f:
            f.write(f"{name},{expiry_date_str}\n")
        print(f"Added: {name} expires on {expiry_date_str}")
    except ValueError:
        print("Invalid date format. Use YYYY-MM-DD")
    except Exception as e:
        print(f"Error writing to file: {e}")

def check_expiring():
    """Show products that expire within 7 days from today"""
    today = datetime.date.today()
    soon = today + datetime.timedelta(days=7)
    
    try:
        with open(PRODUCT_FILE, "r") as f:
            lines = f.readlines()
        
        if not lines:
            print("No products found.")
            return
        
        print(f"\nProducts expiring between {today} and {soon}:")
        found = False
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                name, date_str = line.split(",")
                expiry = datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
                if today <= expiry <= soon:
                    print(f"⚠️ {name} - expires on {expiry}")
                    found = True
            except ValueError:
                print(f"Skipping invalid line: {line}")
        
        if not found:
            print("None.")
    except FileNotFoundError:
        print("No products file found. Add some products first.")

# Example usage
if __name__ == "__main__":
    while True:
        print("\n1. Add product\n2. Check expiring soon\n3. Exit")
        choice = input("Choose: ")
        if choice == "1":
            name = input("Product name: ")
            date = input("Expiry date (YYYY-MM-DD): ")
            add_product(name, date)
        elif choice == "2":
            check_expiring()
        elif choice == "3":
            break
        else:
            print("Invalid choice")

