5. Automated Reminder Script
python
import datetime

REMINDER_FILE = "reminders.txt"

def ensure_file():
    """Create the reminder file if it doesn't exist"""
    try:
        with open(REMINDER_FILE, "x") as f:
            f.write("# Format: YYYY-MM-DD: Reminder text\n")
            f.write("2025-03-20: Call dentist\n")
            f.write("2025-03-21: Submit report\n")
        print(f"Created new reminder file with sample entries.")
    except FileExistsError:
        pass  # File already exists, fine

def show_today_reminders():
    """Read the file and print reminders for today"""
    today = datetime.date.today().isoformat()  # e.g., "2025-03-20"
    
    try:
        with open(REMINDER_FILE, "r") as f:
            lines = f.readlines()
    except FileNotFoundError:
        print("Reminder file not found. Creating one...")
        ensure_file()
        with open(REMINDER_FILE, "r") as f:
            lines = f.readlines()
    
    found = False
    print(f"\nReminders for {today}:")
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        
        # Split on the first colon
        if ": " in line:
            date_part, reminder = line.split(": ", 1)
            if date_part == today:
                print(f"🔔 {reminder}")
                found = True
    
    if not found:
        print("No reminders for today.")

def add_reminder():
    """Add a new reminder from user input"""
    date_str = input("Date (YYYY-MM-DD): ").strip()
    reminder = input("Reminder text: ").strip()
    
    # Validate date format
    try:
        datetime.datetime.strptime(date_str, "%Y-%m-%d")
    except ValueError:
        print("Invalid date format. Use YYYY-MM-DD")
        return
    
    try:
        with open(REMINDER_FILE, "a") as f:
            f.write(f"{date_str}: {reminder}\n")
        print("Reminder added.")
    except Exception as e:
        print(f"Error writing to file: {e}")

if __name__ == "__main__":
    ensure_file()
    while True:
        print("\n1. Show today's reminders\n2. Add new reminder\n3. Exit")
        choice = input("Choose: ")
        if choice == "1":
            show_today_reminders()
        elif choice == "2":
            add_reminder()
        elif choice == "3":
            break
        else:
            print("Invalid choice. Enter 1, 2, or 3.")
