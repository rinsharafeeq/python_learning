3. File Backup with Timestamp
python
import datetime
import shutil
import os

def backup_file():
    """Create a timestamped backup of a given file"""
    filename = input("Enter the file name to back up: ").strip()
    
    if not os.path.exists(filename):
        print(f"Error: File '{filename}' not found.")
        return
    
    # Create timestamp: YYYYMMDD_HHMMSS
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    name, ext = os.path.splitext(filename)
    backup_name = f"{name}_backup_{timestamp}{ext}"
    
    try:
        shutil.copy2(filename, backup_name)  # copy2 preserves metadata
        print(f"Backup created: {backup_name}")
    except PermissionError:
        print("Permission denied: Cannot read the original file or write the backup.")
    except Exception as e:
        print(f"Unexpected error: {e}")

if __name__ == "__main__":
    backup_file()

