import json
import os

class Quiz:
    def __init__(self, filename="questions.json"):
        self.filename = filename
        self.questions = []
        self.score = 0
        self.load_questions()

    def load_questions(self):
        if os.path.exists(self.filename):
            with open(self.filename, "r") as f:
                self.questions = json.load(f)

    def run(self):
        for i, q in enumerate(self.questions, 1):
            print(f"\nQuestion {i}: {q['question']}")
            for idx, opt in enumerate(q['options']):
                print(f"{idx}. {opt}")
            try:
                answer = int(input("Your choice (number): "))
                if answer == q['answer']:
                    print("Correct!")
                    self.score += 1
                else:
                    correct_text = q['options'][q['answer']]
                    print(f"Wrong! Correct answer: {correct_text}")
            except:
                print("Invalid input, skipping.")
        self.save_result()

    def save_result(self, result_file="quiz_results.json"):
        result = {
            "score": self.score,
            "total": len(self.questions),
            "percentage": (self.score / len(self.questions)) * 100
        }
        with open(result_file, "w") as f:
            json.dump(result, f, indent=4)
        print(f"\nQuiz finished! Score: {self.score}/{len(self.questions)}")
        print(f"Result saved to {result_file}")

if __name__ == "__main__":
    quiz = Quiz()
    quiz.run()
8. Password Generator (pip + OOP)
python
import random
import string
import json
import pyperclip
from datetime import datetime

class PasswordGenerator:
    def __init__(self):
        self.lower = string.ascii_lowercase
        self.upper = string.ascii_uppercase
        self.digits = string.digits
        self.symbols = "!@#$%^&*()_+-=[]{}|;:,.<>?"

    def generate(self, length=12, use_uppercase=True, use_digits=True, use_symbols=True):
        pool = self.lower
        if use_uppercase:
            pool += self.upper
        if use_digits:
            pool += self.digits
        if use_symbols:
            pool += self.symbols
        if not pool:
            pool = self.lower
        password = ''.join(random.choice(pool) for _ in range(length))
        return password

    def copy_to_clipboard(self, password):
        pyperclip.copy(password)
        print("Password copied to clipboard!")

class PasswordLogger:
    def __init__(self, filename="passwords.json"):
        self.filename = filename

    def log(self, password, purpose=""):
        try:
            with open(self.filename, "r") as f:
                data = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            data = []
        data.append({
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "password": password,
            "purpose": purpose
        })
        with open(self.filename, "w") as f:
            json.dump(data, f, indent=4)

def main():
    gen = PasswordGenerator()
    logger = PasswordLogger()
    length = int(input("Password length (default 12): ") or 12)
    use_upper = input("Include uppercase? (y/n): ").lower() == 'y'
    use_digits = input("Include digits? (y/n): ").lower() == 'y'
    use_symbols = input("Include symbols? (y/n): ").lower() == 'y'
    password = gen.generate(length, use_upper, use_digits, use_symbols)
    print(f"Generated password: {password}")
    copy = input("Copy to clipboard? (y/n): ").lower()
    if copy == 'y':
        gen.copy_to_clipboard(password)
    purpose = input("Enter purpose (e.g., Gmail, Facebook): ")
    logger.log(password, purpose)
    print("Password logged.")

if __name__ == "__main__":
    main()
Note: Install pyperclip with pip install pyperclip.

