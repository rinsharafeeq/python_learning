import json
import os

class Student:
    def __init__(self, name, roll_number, grades=None):
        self.name = name
        self.roll_number = roll_number
        self.grades = grades if grades is not None else {}

    def add_grade(self, subject, mark):
        self.grades[subject] = mark

    def calculate_average(self):
        if not self.grades:
            return 0
        return sum(self.grades.values()) / len(self.grades)

    def get_report(self):
        report = f"Student: {self.name} (Roll: {self.roll_number})\n"
        for sub, mark in self.grades.items():
            report += f"  {sub}: {mark}\n"
        report += f"Average: {self.calculate_average():.2f}\n"
        return report

    def to_dict(self):
        return {
            "name": self.name,
            "roll_number": self.roll_number,
            "grades": self.grades
        }

    @classmethod
    def from_dict(cls, data):
        return cls(data["name"], data["roll_number"], data["grades"])

class GradeTracker:
    def __init__(self, filename="students.json"):
        self.filename = filename
        self.students = []
        self.load()

    def load(self):
        if os.path.exists(self.filename):
            with open(self.filename, "r") as f:
                data = json.load(f)
                self.students = [Student.from_dict(s) for s in data]

    def save(self):
        with open(self.filename, "w") as f:
            json.dump([s.to_dict() for s in self.students], f, indent=4)

    def add_student(self, name, roll):
        self.students.append(Student(name, roll))
        self.save()

    def find_student(self, roll):
        for s in self.students:
            if s.roll_number == roll:
                return s
        return None

def menu():
    tracker = GradeTracker()
    while True:
        print("\n1. Add Student")
        print("2. Add Grade")
        print("3. View Student Report")
        print("4. Exit")
        choice = input("Choose: ")
        if choice == "1":
            name = input("Name: ")
            roll = input("Roll number: ")
            tracker.add_student(name, roll)
        elif choice == "2":
            roll = input("Roll number: ")
            student = tracker.find_student(roll)
            if student:
                subject = input("Subject: ")
                mark = float(input("Mark: "))
                student.add_grade(subject, mark)
                tracker.save()
            else:
                print("Student not found.")
        elif choice == "3":
            roll = input("Roll number: ")
            student = tracker.find_student(roll)
            if student:
                print(student.get_report())
            else:
                print("Not found.")
        elif choice == "4":
            break

if __name__ == "__main__":
    menu()
5. Simple Contact Book (OOP + JSON)
python
import json
import os

class Contact:
    def __init__(self, name, phone, email):
        self.name = name
        self.phone = phone
        self.email = email

    def to_dict(self):
        return {"name": self.name, "phone": self.phone, "email": self.email}

    @classmethod
    def from_dict(cls, data):
        return cls(data["name"], data["phone"], data["email"])

class ContactBook:
    def __init__(self, filename="contacts.json"):
        self.filename = filename
        self.contacts = []
        self.load()

    def load(self):
        if os.path.exists(self.filename):
            with open(self.filename, "r") as f:
                data = json.load(f)
                self.contacts = [Contact.from_dict(c) for c in data]

    def save(self):
        with open(self.filename, "w") as f:
            json.dump([c.to_dict() for c in self.contacts], f, indent=4)

    def add(self, contact):
        self.contacts.append(contact)
        self.save()

    def delete(self, name):
        self.contacts = [c for c in self.contacts if c.name.lower() != name.lower()]
        self.save()

    def search(self, keyword):
        results = [c for c in self.contacts if keyword.lower() in c.name.lower() or keyword in c.phone]
        return results

    def list_all(self):
        for c in self.contacts:
            print(f"{c.name} | {c.phone} | {c.email}")

def main():
    cb = ContactBook()
    while True:
        print("\n1. Add Contact")
        print("2. Delete Contact")
        print("3. Search")
        print("4. List All")
        print("5. Exit")
        choice = input("Choose: ")
        if choice == "1":
            name = input("Name: ")
            phone = input("Phone: ")
            email = input("Email: ")
            cb.add(Contact(name, phone, email))
        elif choice == "2":
            name = input("Name to delete: ")
            cb.delete(name)
        elif choice == "3":
            kw = input("Search term: ")
            results = cb.search(kw)
            for c in results:
                print(f"{c.name} - {c.phone} - {c.email}")
        elif choice == "4":
            cb.list_all()
        elif choice == "5":
            break

if __name__ == "__main__":
    main()


