1. Library Book Manager (OOP + JSON)
python
import json
import os

class Book:
    def __init__(self, title, author, isbn, available=True):
        self.title = title
        self.author = author
        self.isbn = isbn
        self.available = available

    def to_dict(self):
        return {
            "title": self.title,
            "author": self.author,
            "isbn": self.isbn,
            "available": self.available
        }

    @classmethod
    def from_dict(cls, data):
        return cls(data["title"], data["author"], data["isbn"], data["available"])

    def borrow(self):
        if self.available:
            self.available = False
            return True
        return False

    def return_book(self):
        self.available = True

class Library:
    def __init__(self, filename="library.json"):
        self.filename = filename
        self.books = []
        self.load()

    def load(self):
        if os.path.exists(self.filename):
            with open(self.filename, "r") as f:
                data = json.load(f)
                self.books = [Book.from_dict(b) for b in data]

    def save(self):
        with open(self.filename, "w") as f:
            json.dump([b.to_dict() for b in self.books], f, indent=4)

    def add_book(self, book):
        self.books.append(book)
        self.save()

    def find_book(self, isbn):
        for book in self.books:
            if book.isbn == isbn:
                return book
        return None

    def list_books(self):
        for book in self.books:
            status = "Available" if book.available else "Borrowed"
            print(f"{book.title} by {book.author} [{status}]")

def menu():
    lib = Library()
    while True:
        print("\n1. Add Book")
        print("2. Borrow Book")
        print("3. Return Book")
        print("4. List Books")
        print("5. Exit")
        choice = input("Choose: ")
        if choice == "1":
            title = input("Title: ")
            author = input("Author: ")
            isbn = input("ISBN: ")
            lib.add_book(Book(title, author, isbn))
        elif choice == "2":
            isbn = input("Enter ISBN to borrow: ")
            book = lib.find_book(isbn)
            if book and book.borrow():
                print("Borrowed successfully.")
                lib.save()
            else:
                print("Not available or not found.")
        elif choice == "3":
            isbn = input("Enter ISBN to return: ")
            book = lib.find_book(isbn)
            if book:
                book.return_book()
                lib.save()
                print("Returned.")
        elif choice == "4":
            lib.list_books()
        elif choice == "5":
            break

if __name__ == "__main__":
    menu()
2. Weather CLI App (pip + API + JSON)
python
import requests
import json

class WeatherFetcher:
    def __init__(self, api_key):
        self.api_key = api_key
        self.base_url = "http://api.openweathermap.org/data/2.5/weather"

    def get_weather(self, city):
        params = {
            "q": city,
            "appid": self.api_key,
            "units": "metric"
        }
        try:
            response = requests.get(self.base_url, params=params)
            data = response.json()
            if response.status_code == 200:
                temp = data["main"]["temp"]
                humidity = data["main"]["humidity"]
                description = data["weather"][0]["description"]
                return f"{city}: {temp}°C, {humidity}% humidity, {description}"
            else:
                return f"Error: {data.get('message', 'Unknown error')}"
        except Exception as e:
            return f"Failed: {e}"

if __name__ == "__main__":
    # Get a free API key from https://openweathermap.org/api
    API_KEY = "your_api_key_here"
    fetcher = WeatherFetcher(API_KEY)
    city = input("Enter city name: ")
    print(fetcher.get_weather(city))
Note: She must replace your_api_key_here with her actual OpenWeatherMap API key.

